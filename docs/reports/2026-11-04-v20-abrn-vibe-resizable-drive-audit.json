  "findings": [
    {
      "id": "FND-V20-01",
      "severity": "MEDIUM",
      "status": "FIXED",
      "requirement_ids": [
        "REQ-ABRN-PALETTE"
      ],
      "reproduction": "Click ABRN Slate in topbar mode switcher while browser tab is in an unfocused window.",
      "expected": "Theme switches synchronously to ABRN Slate (data-theme=\"dark\").",
      "actual": "setSkinState(next) is now called immediately before startViewTransition and buttons expose data-testid=\"abrn-mode-light\" / \"abrn-mode-dark\".",
      "cause": "startViewTransition callback waited on document visibility and buttons lacked individual data-testid attributes.",
      "fix": "Called setSkinState(next) immediately in ThemeProvider.tsx and added data-testid attributes in dashboard-layout.tsx.",
      "verification_check_ids": [
        "CHK-LAYOUT-SHELL",
        "CHK-BSK-LIVE"
      ]
    },
    {
      "id": "FND-V20-02",
      "severity": "MEDIUM",
      "status": "FIXED",
      "requirement_ids": [
        "REQ-THREE-PANE-INSPECTOR"
      ],
      "reproduction": "Open /abrn/files at 922px viewport width with all 3 panes visible.",
      "expected": "FileGrid rows remain single-line with readable filenames and VaultInspectorPane shows all 5 format tabs without a horizontal scrollbar.",
      "actual": "FileGrid uses md:flex-nowrap with min-w-[110px] flex-1 on the filename column and VaultInspectorPane uses grid-cols-5 for the format tabs.",
      "cause": "flex-wrap and wide inline secondary action buttons squeezed the filename column on medium desktop viewports.",
      "fix": "Updated FileGrid.tsx to prioritize the filename column on md/lg widths and switched VaultInspectorPane format tabs to grid-cols-5.",
      "verification_check_ids": [
        "CHK-INSPECTOR-PANE",
        "CHK-GRID-CONTEXT",
        "CHK-BSK-LIVE"
      ]
