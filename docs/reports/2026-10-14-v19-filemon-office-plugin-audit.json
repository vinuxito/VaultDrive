      "severity": "HIGH",
      "status": "FIXED",
      "requirement_ids": [
        "REQ-CINEMASCOPE-MODAL-DOCK"
      ],
      "reproduction": "Switch selected file in FilePreviewModal while Blob.prototype.text() is still pending.",
      "expected": "Stale file text and Filemón Office parsed state must not publish after file selection changes.",
      "actual": "Guarded parseFilemonOfficeDocument after blob.text() with requestId === previewGeneration.current.",
      "cause": "Async race when switching files rapidly.",
      "fix": "Sequenced parseFilemonOfficeDocument after await blob.text() with previewGeneration requestId check.",
