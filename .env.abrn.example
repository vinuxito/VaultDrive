# ABRN Drive downstream deployment — server environment reference.
# Copy to `.env` and populate secrets before running docker compose.

# Required — infrastructure
DB_URL=postgres://postgres:postgres@postgres:5432/vaultdrive?sslmode=disable
JWT_SECRET=CHANGE-ME-minimum-32-characters-long-random-string
PORT=8090

# Product identity (matches vaultdrive_client/.env VITE_* vars)
PRODUCT_NAME=ABRN Drive
PRODUCT_SLUG=abrn-drive
BASE_PATH=/abrn/
AGENT_KEY_PREFIX=abrn_ak
# If migrating legacy agent keys minted under a different prefix, list them here.
AGENT_KEY_LEGACY_PREFIXES=abrn_ak

# Networking
PUBLIC_BASE_URL=https://abrndrive.filemonprime.net
CORS_ALLOWED_ORIGINS=https://abrndrive.filemonprime.net,http://localhost:5173

# Admin bootstrap — any address listed here is auto-promoted to admin on startup.
# Replaces the old hardcoded SQL UPDATE in migrations 017 and 035.
ADMIN_BOOTSTRAP_EMAILS=filemon@abrn.mx,v.cazares@abrn.mx

# SMTP (optional — leave unset to disable outbound email)
# SMTP_HOST=
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASS=
# SMTP_FROM=
