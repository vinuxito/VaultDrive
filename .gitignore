# Root-only env file (Go backend secrets). The vaultdrive_client/.env*
# files are frontend branding config, not secrets, and are committed.
/.env

# Go build output
quantix-drive
vaultdrive-frontend
vaultdrive-backend
vaultdrive

# Runtime state
uploads
test
*.temp*.js

# Playwright
vaultdrive_client/playwright-report/
test-results/
vaultdrive_client/test-results/

# Session state from local agent tooling
.omc/
.sisyphus/
.claude/
.gnhf/

# Node
node_modules/
vaultdrive_client/node_modules/

# Editor/OS
.DS_Store
*.swp
.~lock.*

# Secrets — NEVER commit private keys, deploy keys, or credentials.
# These patterns are deliberately broad.
id_rsa
id_rsa.pub
id_ed25519
id_ed25519.pub
id_ecdsa
id_ecdsa.pub
id_dsa
id_dsa.pub
*.pem
*.key
