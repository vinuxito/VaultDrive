# QuantiX Drive — E2E test environment
# Used by Playwright when building the frontend via `npm run build -- --mode test`.
# These values MUST match the button labels and routes expected by e2e/helpers/trust.ts.

# Product identity
VITE_PRODUCT_NAME="QuantiX Drive"
VITE_PRODUCT_SLUG="quantix-drive"
VITE_COMPANY_NAME="QuantiX"
VITE_LOGO_VARIANT="quantix"

# Brand colors (hex)
VITE_PRIMARY_COLOR="#4f46e5"
VITE_ACCENT_COLOR="#6366f1"

# Copy
VITE_LANDING_TAGLINE="Coded for Excellence"
VITE_COPYRIGHT_NOTICE=""

# URLs & routing — must match playwright.config.ts BASE_PATH
# When hitting Go directly (no Apache proxy), API calls must include the base
# path prefix because Go mounts all routes under /quantix/ via StripPrefix.
VITE_PUBLIC_BASE_URL="http://127.0.0.1:8090"
VITE_MARKETING_URL=""
VITE_API_URL="/quantix/api"
VITE_BASE_PATH="/quantix"
VITE_ROOT_HOSTED_HOSTS=""

# Agent API keys
VITE_AGENT_KEY_PREFIX="qx_ak"
VITE_AGENT_KEY_ENV_VAR="QX_KEY"
