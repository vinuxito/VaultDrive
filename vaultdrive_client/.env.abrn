# ABRN Drive — downstream branded deployment overrides
# Activate with: `cp .env.abrn .env.local && npm run build`

# Product identity
VITE_PRODUCT_NAME="ABRN Drive"
VITE_PRODUCT_SLUG="abrn-drive"
VITE_COMPANY_NAME="ABRN Asesores"
VITE_LOGO_VARIANT="abrn"

# Brand colors (burgundy)
VITE_PRIMARY_COLOR="#7a1f2b"
VITE_ACCENT_COLOR="#7d4f50"

# Copy
VITE_LANDING_TAGLINE="Coded for ABRN Asesores"
VITE_COPYRIGHT_NOTICE=""

# URLs & routing
VITE_PUBLIC_BASE_URL="https://abrndrive.filemonprime.net"
VITE_MARKETING_URL="https://abrn.mx"
VITE_API_URL="/abrn/api"
VITE_BASE_PATH="/abrn"
# Production host serves /folder-share, /drop, /request at the root.
VITE_ROOT_HOSTED_HOSTS="abrndrive.filemonprime.net"

# Agent API keys (must match backend AGENT_KEY_PREFIX — legacy key kept for compat)
VITE_AGENT_KEY_PREFIX="abrn_ak"
VITE_AGENT_KEY_ENV_VAR="ABRN_KEY"
