# QuantiX Drive — default frontend environment (committed)
# For local overrides, copy .env.example or .env.abrn to .env.local.

# Product identity
VITE_PRODUCT_NAME="QuantiX Drive"
VITE_PRODUCT_SLUG="quantix-drive"
VITE_COMPANY_NAME="QuantiX"
VITE_LOGO_VARIANT="quantix"

# Brand colors (hex)
VITE_PRIMARY_COLOR="#4f46e5"
VITE_ACCENT_COLOR="#6366f1"

# Copy
VITE_LANDING_TAGLINE="Coded for Excellence"
VITE_COPYRIGHT_NOTICE=""

# URLs & routing
VITE_PUBLIC_BASE_URL="https://app.quantixdrive.io"
VITE_MARKETING_URL="https://quantixdrive.io"
VITE_API_URL="/api"
VITE_BASE_PATH="/quantix"
# CSV of hostnames where the app is served at the site root (no base path).
VITE_ROOT_HOSTED_HOSTS=""

# Agent API keys (must match backend AGENT_KEY_PREFIX)
VITE_AGENT_KEY_PREFIX="qx_ak"
VITE_AGENT_KEY_ENV_VAR="QX_KEY"
