# Generated at build time by brandManifestPlugin in vite.config.ts —
# the manifest.json mirrors active VITE_* branding vars and therefore
# differs per-deployment. Committing it would cause conflicts on every
# branded rebuild. The plugin regenerates it on `npm run build`/`dev`.
